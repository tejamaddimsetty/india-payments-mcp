# Razorpay integration generated by india-payments-mcp.
# Copy to .env (or .env.local for Next.js) and fill in. NEVER commit the filled-in file.
# Values marked SECRET must only ever exist on the server.

# mock (no network, no keys) | sandbox | live
PAYMENTS_MODE=mock
# Comma-separated gateways this app may use
PAYMENTS_PROVIDERS=razorpay
# Public HTTPS origin of this app. Gateways redirect/POST back here. Use your tunnel URL in development.
PUBLIC_BASE_URL=http://localhost:3000

# --- Razorpay credentials (from https://dashboard.razorpay.com) ---
# required: rzp_test_... or rzp_live_... (Dashboard > Account & Settings > API Keys)
RAZORPAY_KEY_ID=
# required, SECRET: Key secret shown once when the key is generated.
RAZORPAY_KEY_SECRET=
# optional, SECRET: Secret you typed when creating the webhook. Required to verify webhooks.
RAZORPAY_WEBHOOK_SECRET=

# Shared secret for the admin-only refund route. Replace with your real auth.
ADMIN_API_TOKEN=

# Optional: append-only JSON-lines audit log of every payment mutation.
PAYMENTS_AUDIT_LOG=
