{
  // Standalone project: run `npm install` here first. Inside this repo, "paths" points the SDK at
  // ../../src so the example type-checks (and runs with tsx) without building the package.
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "lib": ["ES2022"],
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": { "india-payments-mcp": ["../../src/index.ts"] }
  },
  "include": ["server.ts"]
}
