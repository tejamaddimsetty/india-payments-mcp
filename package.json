{
  "name": "india-payments-mcp",
  "version": "0.4.1",
  "description": "One MCP server and TypeScript SDK for Indian payment gateways: Razorpay, PayU, Cashfree, CCAvenue, Paytm, PhonePe, Stripe, Dodo Payments, Skydo and Infinity.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "india-payments-mcp": "dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "doctor": "tsx src/cli.ts doctor",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/cli.ts",
    "sandbox:smoke": "tsx scripts/sandbox-smoke.ts",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "payments",
    "india",
    "razorpay",
    "payu",
    "cashfree",
    "ccavenue",
    "paytm",
    "phonepe",
    "stripe",
    "skydo",
    "infinity",
    "dodo-payments",
    "zoho-books",
    "payment-gateway",
    "upi",
    "claude",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tejamaddimsetty/india-payments-mcp.git"
  },
  "homepage": "https://github.com/tejamaddimsetty/india-payments-mcp#readme",
  "bugs": {
    "url": "https://github.com/tejamaddimsetty/india-payments-mcp/issues"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "standardwebhooks": "^1.1.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^4.1.12"
  }
}
