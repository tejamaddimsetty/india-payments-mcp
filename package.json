{
  "name": "india-payments-mcp",
  "version": "0.1.0",
  "description": "One MCP server and TypeScript SDK for every major Indian payment gateway: Razorpay, PayU, Cashfree, CCAvenue, Paytm, PhonePe, Stripe and Skydo.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "bin": {
    "india-payments-mcp": "./dist/cli.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "dev": "tsx src/cli.ts",
    "start": "node dist/cli.js",
    "doctor": "tsx src/cli.ts doctor",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "inspect": "npx @modelcontextprotocol/inspector tsx src/cli.ts",
    "sandbox:smoke": "tsx scripts/sandbox-smoke.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "payments",
    "india",
    "razorpay",
    "payu",
    "cashfree",
    "ccavenue",
    "paytm",
    "phonepe",
    "stripe",
    "skydo",
    "upi",
    "claude",
    "agents"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tejamaddimsetty/india-payments-mcp.git"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "vitest": "^3.2.0"
  }
}
