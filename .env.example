# india-payments-mcp configuration
# Copy to .env (never commit .env). Every value below is a placeholder.
# Run `npx india-payments-mcp doctor` to see which gateways are configured. It never prints secret values.

# ---------------------------------------------------------------------------
# Global
# ---------------------------------------------------------------------------

# mock    = no network, no credentials, simulated gateways (start here)
# sandbox = gateway test environments with test keys (default when unset)
# live    = real money. Also accepts "production"/"prod"; "test" maps to sandbox.
PAYMENTS_MODE=mock

# Comma-separated allowlist of gateways. Default: all of
# razorpay,payu,cashfree,ccavenue,paytm,phonepe,stripe,skydo
# PAYMENTS_PROVIDERS=razorpay,cashfree

# Live-mode safety rail for the MCP server (AI agents). Refunds and subscription cancellations in live
# mode are blocked unless this is true AND the individual call passes confirm=true. Leave unset unless
# a human approves each call. SDK use in your own app is not gated (opt in with guardLiveMutations).
# PAYMENTS_ALLOW_LIVE_MUTATIONS=false

# Mock mode refuses to start when NODE_ENV=production. Override only for a public demo.
# PAYMENTS_ALLOW_MOCK_IN_PRODUCTION=false

# Append-only JSON Lines audit log of create/refund/subscription actions (file is created with mode 0600).
# PAYMENTS_AUDIT_LOG=/var/log/india-payments/audit.jsonl

# debug | info | warn | error. Logs go to stderr as JSON, with secret-looking keys redacted.
# PAYMENTS_LOG_LEVEL=info

# Per-request timeout to gateways, in milliseconds. Default 30000.
# PAYMENTS_HTTP_TIMEOUT_MS=30000

# Retries for retry-safe requests only (GETs and de-duplicated POSTs). Default 2.
# PAYMENTS_MAX_RETRIES=2

# ---------------------------------------------------------------------------
# HTTP transport (`india-payments-mcp http`). Not needed for stdio.
# ---------------------------------------------------------------------------

# Required, 24+ characters. Generate with: openssl rand -hex 32
# MCP_HTTP_TOKEN=replace-with-output-of-openssl-rand-hex-32
# Default 127.0.0.1. Use 0.0.0.0 only inside a container or behind a reverse proxy.
# MCP_HTTP_HOST=127.0.0.1
# MCP_HTTP_PORT=8787

# ---------------------------------------------------------------------------
# Razorpay  (Dashboard > Account & Settings > API Keys)
# Test and live share one API host; the key prefix (rzp_test_ / rzp_live_) decides the environment.
# The adapter refuses rzp_live_ keys in sandbox mode and rzp_test_ keys in live mode.
# ---------------------------------------------------------------------------
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxxxx
RAZORPAY_KEY_SECRET=replace-me
# The secret you typed when creating the webhook. NOT the key secret.
RAZORPAY_WEBHOOK_SECRET=replace-me

# ---------------------------------------------------------------------------
# PayU India  (Dashboard > Developers > API keys). Salt signs requests and verifies responses/webhooks.
# ---------------------------------------------------------------------------
PAYU_MERCHANT_KEY=replace-me
PAYU_MERCHANT_SALT=replace-me

# ---------------------------------------------------------------------------
# Cashfree PG  (Dashboard > Developers > API Keys). Sandbox and production keys differ.
# The client secret also verifies webhook signatures.
# ---------------------------------------------------------------------------
CASHFREE_CLIENT_ID=replace-me
CASHFREE_CLIENT_SECRET=replace-me

# ---------------------------------------------------------------------------
# CCAvenue  (M.A.R.S. dashboard > Settings > API Keys)
# Your server's egress IP must be whitelisted with CCAvenue before server APIs work.
# ---------------------------------------------------------------------------
CCAVENUE_MERCHANT_ID=replace-me
CCAVENUE_ACCESS_CODE=replace-me
CCAVENUE_WORKING_KEY=replace-me

# ---------------------------------------------------------------------------
# Paytm Payments  (paytmpayments.com dashboard > Developer Settings > API Keys)
# PAYTM_WEBSITE is WEBSTAGING in staging and DEFAULT in production (or the value Paytm assigned you).
# ---------------------------------------------------------------------------
PAYTM_MID=replace-me
PAYTM_MERCHANT_KEY=replace-me-16-chars
PAYTM_WEBSITE=WEBSTAGING

# ---------------------------------------------------------------------------
# PhonePe PG Standard Checkout v2  (Business Dashboard > Developer Settings)
# Sandbox credentials come from the PhonePe integration team. Legacy v1 salt keys are NOT supported.
# ---------------------------------------------------------------------------
PHONEPE_CLIENT_ID=replace-me
PHONEPE_CLIENT_SECRET=replace-me
PHONEPE_CLIENT_VERSION=1
# Username/password you set for the webhook in the Business Dashboard.
PHONEPE_WEBHOOK_USERNAME=replace-me
PHONEPE_WEBHOOK_PASSWORD=replace-me

# ---------------------------------------------------------------------------
# Stripe  (Dashboard > Developers > API keys). Invite-only for Indian businesses.
# ---------------------------------------------------------------------------
STRIPE_SECRET_KEY=sk_test_replace-me
STRIPE_PUBLISHABLE_KEY=pk_test_replace-me
# whsec_... from the webhook endpoint (or `stripe listen` locally).
STRIPE_WEBHOOK_SECRET=whsec_replace-me

# ---------------------------------------------------------------------------
# Skydo: no public API, so no credentials. The adapter returns guidance only.
# ---------------------------------------------------------------------------
